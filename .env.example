# ============================================================
# GeoSense — CONTOH FILE .env
# Salin file ini menjadi .env lalu isi dengan API key Anda.
# JANGAN isi file ini dengan key asli — hanya placeholder.
# ============================================================

# Google AI Studio — Gemini API Key khusus AI Quiz / generator soal
GEMINI_QUIZ_KEY=your_gemini_quiz_key_here

# Google AI Studio — Gemini API Key khusus AI Chat pembelajaran
GEMINI_CHAT_KEY=your_gemini_chat_key_here

# Google AI Studio — Gemini API Key khusus Chatbot / GeoBot
GEMINI_CHATBOT_KEY=your_gemini_chatbot_key_here

# (Optional) Port untuk lokal server
PORT=3001

# ============================================================
# Vercel PostgreSQL & Blob Storage
# ============================================================
# Gunakan URL PostgreSQL Anda (misalnya postgres://user:password@host/dbname)
DATABASE_URL=
POSTGRES_URL=

# Token read/write untuk Vercel Blob
BLOB_READ_WRITE_TOKEN=
