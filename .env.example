# Salin file ini ke .env lalu isi dengan kredensial Anda sendiri.
# Jangan pernah menuliskan key atau token asli ke file ini.

PORT=3001
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Google AI Studio (Gemini)
GEMINI_QUIZ_KEY=your_gemini_quiz_key_here
GEMINI_CHAT_KEY=your_gemini_chat_key_here
GEMINI_CHATBOT_KEY=your_gemini_chatbot_key_here
GEMINI_WEATHER_KEY=your_gemini_weather_key_here
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL (Neon / Vercel Postgres) & Vercel Blob Storage
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
POSTGRES_URL=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Layanan Geospasial Eksternal (Opsional)
FIRMS_MAP_KEY=your_firms_map_key_here
TOMTOM_API_KEY=your_tomtom_api_key_here
ORS_API_KEY=your_openrouteservice_api_key_here
