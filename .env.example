# ============================================================
# GeoSense — CONTOH FILE .env
# Salin file ini menjadi .env lalu isi dengan API key Anda.
# JANGAN isi file ini dengan key asli — hanya placeholder.
# ============================================================

# Google AI Studio — Gemini API Key untuk Quiz AI
VITE_GEMINI_QUIZ_KEY=your_gemini_quiz_api_key_here

# Google AI Studio — Gemini API Key untuk GeoBot Chatbot
VITE_GEMINI_CHAT_KEY=your_gemini_chat_api_key_here

# (Opsional) Gemini API Key umum / fallback
VITE_GEMINI_API_KEY=your_gemini_api_key_here
