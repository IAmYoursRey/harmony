# Salin ke apps/server/.env untuk pengembangan lokal (jangan isi token asli di file ini)
PORT=3001
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
POSTGRES_URL=

BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

GEMINI_QUIZ_KEY=your_gemini_api_key_here
GEMINI_CHAT_KEY=your_gemini_api_key_here
GEMINI_CHATBOT_KEY=your_gemini_api_key_here
GEMINI_WEATHER_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

FIRMS_MAP_KEY=your_nasa_firms_map_key_here
TOMTOM_API_KEY=your_tomtom_api_key_here
ORS_API_KEY=your_openrouteservice_api_key_here
